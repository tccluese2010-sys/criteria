    <div class="auth-panel" id="panel-signup">
      <div id="err-signup" class="auth-error"></div>
      <input type="text" class="auth-input" id="su-name" placeholder="Full name" />
      <input type="email" class="auth-input" id="su-email" placeholder="Email address" />
      <input type="password" class="auth-input" id="su-pass" placeholder="Password (min 6 chars)" />
      <button class="auth-btn-primary" onclick="emailSignUp()">Create Account &#x2192;</button>
      <div class="auth-divider">or</div>
      <button class="auth-google-btn" onclick="googleSignIn()">
        <svg class="google-icon" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
        Continue with Google
      </button>
      <div class="auth-switch">Have an account? <a href="#" onclick="switchTab('signin');return false;">Sign in</a></div>
    </div>
  </div>
</div>
<div class="auth-toast" id="auth-toast"></div>

<!-- NAV -->
<nav>
  <a href="#" class="nav-logo">
    <div class="nav-logo-dot"></div>
    CRITERIA
  </a>
  <ul class="nav-links">
    <li><a href="#services">Services</a></li>
    <li><a href="#how">How it works</a></li>
    <li><a href="#gallery">Work</a></li>
    <li><a href="#faq">FAQ</a></li>
    <li><a href="#" class="nav-signin" id="nav-signin-btn" onclick="openAuth(event)">Sign In</a></li>
    <li><a href="#request" class="nav-cta">Get Started</a></li>
  </ul>
  <!-- USER AVATAR (shown after login) -->
  <div id="nav-user" style="display:none; align-items:center; gap:10px; position:relative;">
    <div id="nav-avatar" style="
      width:36px; height:36px; border-radius:50%;
      background:var(--gold-glow); border:2px solid var(--gold-border);
      display:flex; align-items:center; justify-content:center;
      font-family:var(--font-display); font-weight:700; font-size:0.75rem;
      color:var(--gold); cursor:pointer; overflow:hidden; flex-shrink:0;
      transition:border-color 0.3s ease;
    " onclick="toggleUserMenu()"></div>
    <div id="user-dropdown" style="
      display:none; position:absolute; top:48px; right:0;
      background:var(--bg-3); border:1px solid var(--border-hover);
      border-radius:16px; padding:0.5rem; min-width:210px;
      z-index:200; box-shadow:0 20px 60px rgba(0,0,0,0.5);
