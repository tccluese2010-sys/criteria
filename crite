};

const app  = initializeApp(firebaseConfig);
const auth = getAuth(app);
const googleProvider = new GoogleAuthProvider();

// ── AUTH STATE LISTENER ──
onAuthStateChanged(auth, user => {
  const signinBtn = document.getElementById('nav-signin-btn');
  const navUser   = document.getElementById('nav-user');
  const navLinks  = document.querySelector('.nav-links');
  if (user) {
    if (signinBtn) signinBtn.style.display = 'none';
    if (navUser)   { navUser.style.display = 'flex'; }
    const initials = (user.displayName || user.email || '?').slice(0,2).toUpperCase();
    const avatar   = document.getElementById('nav-avatar');
    const emailEl  = document.getElementById('user-email-display');
    if (avatar)  avatar.textContent = initials;
    if (emailEl) emailEl.textContent = user.email;
    closeAuth();
    showToast('Signed in as ' + (user.displayName || user.email), true);
  } else {
    if (signinBtn) signinBtn.style.display = '';
    if (navUser)   navUser.style.display = 'none';
  }
});

// ── GOOGLE SIGN IN ──
window.googleSignIn = async function() {
  try {
    await signInWithPopup(auth, googleProvider);
  } catch(e) {
    showAuthError(e.message);
  }
};

// ── EMAIL SIGN IN ──
window.emailSignIn = async function() {
  const email = document.getElementById('si-email').value.trim();
  const pass  = document.getElementById('si-pass').value;
  clearErrors();
  if (!email || !pass) { showAuthError('Please fill in all fields.', 'signin'); return; }
  try {
    await signInWithEmailAndPassword(auth, email, pass);
  } catch(e) {
    const msg = e.code === 'auth/invalid-credential' ? 'Incorrect email or password.' : e.message;
    showAuthError(msg, 'signin');
  }
};

// ── EMAIL SIGN UP ──
window.emailSignUp = async function() {
  const name  = document.getElementById('su-name').value.trim();
  const email = document.getElementById('su-email').value.trim();
  const pass  = document.getElementById('su-pass').value;
  clearErrors();
  if (!name || !email || !pass) { showAuthError('Please fill in all fields.', 'signup'); return; }
  if (pass.length < 6) { showAuthError('Password must be at least 6 characters.', 'signup'); return; }
  try {
    const cred = await createUserWithEmailAndPassword(auth, email, pass);
    await updateProfile(cred.user, { displayName: name });
  } catch(e) {
    const msg = e.code === 'auth/email-already-in-use' ? 'This email is already registered.' : e.message;
    showAuthError(msg, 'signup');
  }
};

// ── SIGN OUT ──
window.signOutUser = async function(e) {
  e.preventDefault();
  await signOut(auth);
  document.getElementById('user-dropdown').style.display = 'none';
  showToast('You have been signed out.');
};

// ── HELPERS ──
function showAuthError(msg, panel = 'signin') {
  const el = document.getElementById('err-' + panel);
  if (el) { el.textContent = msg; el.classList.add('show'); }
}
function clearErrors() {
  ['err-signin','err-signup'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.classList.remove('show');
  });
}

window.showToast = function(msg, gold = false) {
  const t = document.getElementById('auth-toast');
  t.textContent = msg;
  t.className = 'auth-toast show' + (gold ? ' gold' : '');
  setTimeout(() => t.className = 'auth-toast', 3500);
};

// ── MODAL CONTROLS ──
window.openAuth = function(e) {
  if (e) e.preventDefault();
  document.getElementById('auth-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
};
window.closeAuth = function() {
  document.getElementById('auth-overlay').classList.remove('open');
  document.body.style.overflow = '';
};
window.handleOverlayClick = function(e) {
  if (e.target === document.getElementById('auth-overlay')) closeAuth();
};
window.switchTab = function(tab) {
  ['signin','signup'].forEach(t => {
    document.getElementById('tab-'+t).classList.toggle('active', t === tab);
    document.getElementById('panel-'+t).classList.toggle('active', t === tab);
  });
  clearErrors();
};
window.toggleUserMenu = function() {
  const dd = document.getElementById('user-dropdown');
  dd.style.display = dd.style.display === 'block' ? 'none' : 'block';
};

// Close dropdown on outside click
document.addEventListener('click', e => {
  const avatar = document.getElementById('nav-avatar');
  const dd     = document.getElementById('user-dropdown');
  if (dd && avatar && !avatar.contains(e.target) && !dd.contains(e.target)) {
    dd.style.display = 'none';
  }
});

// ── CURSOR ──
const cursor = document.getElementById('cursor');
let cx = 0, cy = 0, tx = 0, ty = 0;

document.addEventListener('mousemove', e => { tx = e.clientX; ty = e.clientY; });

function animateCursor() {
  cx += (tx - cx) * 0.15;
  cy += (ty - cy) * 0.15;
  cursor.style.left = cx + 'px';
  cursor.style.top = cy + 'px';
  requestAnimationFrame(animateCursor);
}
animateCursor();

document.querySelectorAll('a, button, .chip, .step, .faq-item, .service-card, .gallery-item').forEach(el => {
  el.addEventListener('mouseenter', () => cursor.classList.add('expand'));
  el.addEventListener('mouseleave', () => cursor.classList.remove('expand'));
});

// ── MARQUEE ──
const marqueeItems = [
  'Poster Design', 'Brand Identity', 'Web Development',
  'Thumbnail Art', 'Video Editing', 'UI Design',
  'Logo Design', 'Motion Graphics', 'Typography',
  'Creative Strategy', 'Visual Storytelling', 'Digital Art'
];

const track = document.getElementById('marquee-track');
const allItems = [...marqueeItems, ...marqueeItems];
track.innerHTML = allItems.map(t =>
  `<div class="marquee-item"><span class="dot">◆</span>${t}</div>`
).join('');

// ── SCROLL REVEAL ──
const revealEls = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.12 });
revealEls.forEach(el => observer.observe(el));

// ── HOW IT WORKS STEPS ──
const stepData = [
  { emoji: '📋', label: 'Submit Your Request', sub: 'Tell us your vision, deadline, and budget — we\'ll take it from there.' },
  { emoji: '🎨', label: 'We Build a Free Preview', sub: 'A watermarked preview or live demo link, crafted with care — before payment.' },
  { emoji: '✏️', label: 'Approve and Refine', sub: 'Request changes freely. We revise until you\'re genuinely happy with the direction.' },
  { emoji: '✅', label: 'Pay. Receive Final Files.', sub: 'One clean payment. Instant delivery of all full-resolution, clean final files.' }
];

const steps = document.querySelectorAll('.step');
const visual = document.getElementById('step-visual-inner');
const emoji = document.getElementById('step-emoji');
const label = document.getElementById('step-label');
const sub = document.getElementById('step-sub');

function updateVisual(index) {
  visual.classList.remove('visible');
  setTimeout(() => {
    emoji.textContent = stepData[index].emoji;
    label.textContent = stepData[index].label;
    sub.textContent = stepData[index].sub;
    visual.classList.add('visible');
  }, 200);
}

steps.forEach((step, i) => {
  step.addEventListener('click', () => {
    steps.forEach(s => s.classList.remove('active'));
    step.classList.add('active');
    updateVisual(i);
  });
});

// Auto-cycle steps
let currentStep = 0;
setInterval(() => {
  currentStep = (currentStep + 1) % steps.length;
  steps.forEach(s => s.classList.remove('active'));
  steps[currentStep].classList.add('active');
  updateVisual(currentStep);
}, 3500);

// ── SERVICE CHIPS ──
document.querySelectorAll('.chip').forEach(chip => {
  chip.addEventListener('click', () => chip.classList.toggle('selected'));
});

// ── FAQ ──
window.toggleFaq = function(item) {
  const isOpen = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(f => f.classList.remove('open'));
  if (!isOpen) item.classList.add('open');
};

// ── FORM SUBMIT ──
window.submitForm = async function() {
  const name = document.getElementById('f-name').value.trim();
  const email = document.getElementById('f-email').value.trim();
  const desc = document.getElementById('f-desc').value.trim();
  const budget = document.getElementById('f-budget').value;
  const deadline = document.getElementById('f-deadline').value;
  const refs = document.getElementById('f-refs').value.trim();
  const services = [...document.querySelectorAll('.chip.selected')].map(c => c.dataset.val).join(', ');

  const btn = document.getElementById('form-submit-btn');

  if (!name || !email || !desc) {
    btn.style.background = '#ff4444';
    btn.textContent = 'Please fill required fields →';
    setTimeout(() => {
      btn.style.background = '';
      btn.textContent = 'Submit Request — Free Preview →';
    }, 2000);
    return;
  }

  btn.textContent = 'Sending...';
  btn.disabled = true;
//emailJs
  try {
    await emailjs.send("service_c45xjgq", "template_hgurwab", {
      service: services,
      name: name,
      email: email,
      budget: budget || 'Not specified',
      deadline: deadline || 'Not specified',
      description: desc,
      references: refs || 'None'
    });

    document.getElementById('form-content').style.display = 'none';
    document.getElementById('form-success').style.display = 'flex';
  } catch (err) {
    btn.style.background = '#ff4444';
    btn.textContent = 'Failed to send. Try again →';
    setTimeout(() => {
      btn.style.background = '';
      btn.textContent = 'Submit Request — Free Preview →';
      btn.disabled = false;
    }, 3000);
  }
};

window.resetForm = function() {
  document.getElementById('form-content').style.display = '';
  document.getElementById('form-success').style.display = 'none';
  ['f-name','f-email','f-desc','f-refs'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('f-budget').value = '';
  document.querySelectorAll('.chip').forEach((c,i) => {
    c.classList.toggle('selected', i === 0);
  });
};

// ── NAV ACTIVE STATE ──
const sections = document.querySelectorAll('section[id]');
window.addEventListener('scroll', () => {
  const scrollY = window.scrollY;
  sections.forEach(sec => {
    const top = sec.offsetTop - 100;
    const bottom = top + sec.offsetHeight;
    const link = document.querySelector(`.nav-links a[href="#${sec.id}"]`);
    if (link) {
      link.style.color = scrollY >= top && scrollY < bottom ? 'var(--text)' : '';
    }
  });
});
</script>

